# Neon Postgres connection string (use a dev branch locally).
# Leave empty locally to use an in-memory Postgres (PGlite) - fine for testing on your LAN.
DATABASE_URL=

# Optional TURN relay for phones on networks where direct WebRTC fails (e.g. some cellular / guest wifi).
# Example: turn:global.relay.metered.ca:80
TURN_URL=
TURN_USER=
TURN_PASS=
